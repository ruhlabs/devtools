{
  "name": "@ruhlabs/status",
  "version": "0.1.0",
  "private": true,
  "description": "Public status page for Ruh Labs services, built on Uptime Kuma's public API",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node --disable-warning=ExperimentalWarning dist/index.js\"",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17"
  }
}
