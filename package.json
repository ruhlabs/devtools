{
  "name": "ruhlabs-devtools",
  "private": true,
  "description": "Developer tools for Maldivian developers, by Ruh Labs",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @ruhlabs/api --filter @ruhlabs/status build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @ruhlabs/api dev",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "dev:status": "pnpm --filter @ruhlabs/status dev"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
