{
  "name": "@maavadi/validators",
  "version": "0.1.0",
  "description": "Validators and formatters for Maldivian phone numbers and national ID card numbers",
  "license": "MIT",
  "author": "Ruh Labs",
  "repository": { "type": "git", "url": "git+https://github.com/ruhlabs/maavadi.git", "directory": "packages/validators" },
  "keywords": ["maldives", "validation", "phone", "national-id", "maavadi"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
