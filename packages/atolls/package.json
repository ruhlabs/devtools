{
  "name": "@ruhlabs/atolls",
  "version": "0.1.0",
  "description": "Maldivian administrative atolls and cities: codes, names, capitals and address parsing",
  "license": "MIT",
  "author": "Ruh Labs",
  "repository": { "type": "git", "url": "git+https://github.com/ruhlabs/devtools.git", "directory": "packages/atolls" },
  "keywords": ["maldives", "atolls", "islands", "address", "ruhlabs"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
